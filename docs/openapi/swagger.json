{
    "components": {
        "schemas": {
            "delivery.AuthResponse": {
                "properties": {
                    "message": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "statusCode": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    }
                },
                "type": "object"
            },
            "delivery.HealthResponse": {
                "properties": {
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "status"
                ],
                "type": "object"
            },
            "delivery.LoginRequest": {
                "properties": {
                    "password": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    }
                },
                "required": [
                    "password",
                    "username"
                ],
                "type": "object"
            },
            "delivery.RegisterRequest": {
                "properties": {
                    "email": {
                        "description": "Email trimmes og skal indeholde @.",
                        "type": "string"
                    },
                    "password": {
                        "description": "Password skal være mindst 10 bytes i den nuværende kode.",
                        "type": "string"
                    },
                    "password2": {
                        "description": "Valgfrit; skal matche password, hvis feltet sendes.",
                        "type": "string"
                    },
                    "username": {
                        "description": "Brugernavnet trimmes og skal være 3–50 bytes i den nuværende kode.",
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "password",
                    "username"
                ],
                "type": "object"
            },
            "delivery.RequestValidationError": {
                "properties": {
                    "message": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "statusCode": {
                        "default": 422,
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "delivery.SearchErrorResponse": {
                "properties": {
                    "error": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "delivery.SearchResponse": {
                "properties": {
                    "data": {
                        "items": {
                            "additionalProperties": {},
                            "type": "object"
                        },
                        "type": "array",
                        "uniqueItems": false
                    }
                },
                "required": [
                    "data"
                ],
                "type": "object"
            },
            "delivery.ValidationErrorDetail": {
                "properties": {
                    "loc": {
                        "items": {
                            "type": [
                                "string",
                                "integer"
                            ]
                        },
                        "type": "array",
                        "uniqueItems": false
                    },
                    "msg": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    }
                },
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "type": "object"
            },
            "delivery.ValidationErrorResponse": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/delivery.ValidationErrorDetail"
                        },
                        "type": "array",
                        "uniqueItems": false
                    }
                },
                "type": "object"
            }
        }
    },
    "info": {
        "description": "API til WhoKnows-projektet.",
        "title": "WhoKnows",
        "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/": {
            "get": {
                "description": "Viser søgeformularen og eventuelle søgeresultater.",
                "parameters": [
                    {
                        "description": "Søgetekst",
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Sprogfilter",
                        "in": "query",
                        "name": "language",
                        "schema": {
                            "default": "en",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Søgesiden som HTML"
                    },
                    "500": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Søgesiden med en fejlbesked"
                    }
                },
                "summary": "Vis søgesiden",
                "tags": [
                    "Pages"
                ]
            }
        },
        "/about": {
            "get": {
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Informationssiden som HTML"
                    }
                },
                "summary": "Vis informationssiden",
                "tags": [
                    "Pages"
                ]
            }
        },
        "/api/login": {
            "post": {
                "description": "Autentificerer brugeren og opretter en sessionscookie.",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/delivery.LoginRequest",
                                "description": "Loginoplysninger",
                                "summary": "credentials"
                            }
                        }
                    },
                    "description": "Loginoplysninger",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "401": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "Unauthorized"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.ValidationErrorResponse"
                                }
                            }
                        },
                        "description": "Unprocessable Entity"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Log brugeren ind",
                "tags": [
                    "Authentication"
                ]
            }
        },
        "/api/logout": {
            "get": {
                "description": "Rydder den aktuelle brugers session.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Log brugeren ud",
                "tags": [
                    "Authentication"
                ]
            }
        },
        "/api/register": {
            "post": {
                "description": "Opretter en bruger. password2 er valgfrit, men skal matche password, hvis det sendes.",
                "requestBody": {
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/delivery.RegisterRequest",
                                "description": "Registreringsoplysninger",
                                "summary": "credentials"
                            }
                        }
                    },
                    "description": "Registreringsoplysninger",
                    "required": true
                },
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.ValidationErrorResponse"
                                }
                            }
                        },
                        "description": "Unprocessable Entity"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.AuthResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Opret en bruger",
                "tags": [
                    "Authentication"
                ]
            }
        },
        "/api/search": {
            "get": {
                "description": "q skal være med i URL'en, men må være tom. Tom søgning eller ingen resultater giver {\"data\":[]}.",
                "parameters": [
                    {
                        "description": "Søgetekst; tom værdi er tilladt",
                        "in": "query",
                        "name": "q",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Sprogfilter",
                        "in": "query",
                        "name": "language",
                        "schema": {
                            "default": "en",
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.SearchResponse"
                                }
                            }
                        },
                        "description": "OK"
                    },
                    "422": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.RequestValidationError"
                                }
                            }
                        },
                        "description": "Query-parameteren q mangler"
                    },
                    "500": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.SearchErrorResponse"
                                }
                            }
                        },
                        "description": "Internal Server Error"
                    }
                },
                "summary": "Søg efter sider",
                "tags": [
                    "Search"
                ]
            }
        },
        "/health": {
            "get": {
                "description": "Kontrollerer HTTP-serveren, ikke databaseforbindelsen.",
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/delivery.HealthResponse"
                                }
                            }
                        },
                        "description": "OK"
                    }
                },
                "summary": "Kontrollér at applikationen svarer",
                "tags": [
                    "Health"
                ]
            }
        },
        "/login": {
            "get": {
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Loginformularen som HTML"
                    }
                },
                "summary": "Vis loginformularen",
                "tags": [
                    "Pages"
                ]
            }
        },
        "/register": {
            "get": {
                "responses": {
                    "200": {
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "description": "Registreringsformularen som HTML"
                    }
                },
                "summary": "Vis registreringsformularen",
                "tags": [
                    "Pages"
                ]
            }
        }
    }
}
